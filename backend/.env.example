# 会话签名密钥：必须自行生成并保密（python -c "import secrets;print(secrets.token_hex(32))"）。
# 留空或使用示例值时，后端会在非调试模式下自动生成并持久化到 backend/data/.secret_key。
SECRET_KEY=
# 生产 HTTPS 域名部署时启用（与 nginx 反代配合）
BEHIND_PROXY=1
SESSION_COOKIE_SECURE=1
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5320
DEFAULT_LOCALE=zh-CN
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 启动性能：生产默认快速重启，不跑迁移/种子（升级后执行 python scripts/upgrade_db.py）
# TPC_SKIP_STARTUP_MAINTENANCE=1
# 若希望某次重启顺带跑维护，可临时设 TPC_RUN_STARTUP_MAINTENANCE=1
