<Window x:Class="TPCWorkflow.Client.ServerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="服务器设置"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Microsoft YaHei UI, Segoe UI, Ubuntu, sans-serif">
  <StackPanel Margin="28,24,28,28">
    <TextBlock Text="接口地址" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="ServerBox" Style="{StaticResource InputBox}" />
    <TextBlock Margin="0,8,0,20" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"
               Text="示例：https://wf.imcsh.com" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Style="{StaticResource GhostButton}" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Content="保存" Style="{StaticResource PrimaryButton}" Width="80" Click="Save_Click" />
    </StackPanel>
  </StackPanel>
</Window>
