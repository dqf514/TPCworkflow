<Window x:Class="TPCWorkflow.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="480"
        SizeToContent="Height"
        MinHeight="360"
        MaxHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WinContentBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI, Ubuntu, sans-serif">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="客户端设置" FontSize="16" FontWeight="SemiBold"
               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ServerBox" Style="{StaticResource InputBox}" Margin="0,0,0,14" />

        <TextBlock Text="设备名称" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="DeviceBox" Style="{StaticResource InputBox}" Margin="0,0,0,14" />

        <CheckBox x:Name="TrayCheck" Content="关闭窗口时最小化到托盘" Margin="0,2,0,6" />
        <CheckBox x:Name="NotifyCheck" Content="启用新待办通知" Margin="0,2,0,6" />
        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,2,0,10" />
        <CheckBox x:Name="AutoUpdateCheck" Content="自动检查软件更新" Margin="0,2,0,10" />

        <TextBlock x:Name="VersionInfoText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,0,8" />
        <Button Content="检查更新" Style="{StaticResource WinDialogButton}" HorizontalAlignment="Left"
                Margin="0,0,0,10" Click="CheckUpdate_Click" />

        <TextBlock Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12"
                   Text="修改服务器地址后需重新登录。" />
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" BorderBrush="{StaticResource WinNavBorderBrush}" BorderThickness="0,1,0,0"
            Margin="0,16,0,0" Padding="0,14,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Style="{StaticResource WinDialogButton}" Margin="0,0,8,0" Click="Cancel_Click" />
        <Button Content="保存" Style="{StaticResource WinDialogPrimaryButton}" Click="Save_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
