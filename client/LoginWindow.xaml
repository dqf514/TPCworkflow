<Window x:Class="TPCWorkflow.Client.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="登录"
        Width="400"
        SizeToContent="Height"
        MinHeight="580"
        MaxHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Microsoft YaHei UI, Segoe UI, Ubuntu, sans-serif">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="5"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="36" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Background="White" Cursor="SizeAll"
          MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Width="36" Height="36" ToolTip="服务器设置" Click="SettingsGear_Click" Cursor="Hand"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="bd" Background="Transparent" CornerRadius="4" Width="36" Height="36">
                <TextBlock Text="⚙" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="bd" Property="Background" Value="#F5F6FA" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
        </Button>
        <Button Style="{StaticResource WinCaptionCloseButton}" Content="&#xE8BB;"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="CloseButton_Click"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="32,8,32,32">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
          <Border Width="40" Height="40" CornerRadius="0" ClipToBounds="True"
                  SnapsToDevicePixels="True" Margin="0,0,12,0">
            <Image Source="/Assets/app-icon.png" Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality" />
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="AppNameText" Text="工作台" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock x:Name="CompanyText" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0" />
          </StackPanel>
        </StackPanel>

        <Border Background="#F5F6FA" CornerRadius="8" Padding="3" Margin="0,0,0,20">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PwdTabBtn" Grid.Column="0" Content="账号密码" Click="PwdTab_Click" Height="32"
                    Background="{StaticResource BrandBrush}" Foreground="White" BorderThickness="0" Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Button x:Name="EmailTabBtn" Grid.Column="1" Content="邮箱验证码" Click="EmailTab_Click" Height="32"
                    Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}" BorderThickness="0" Cursor="Hand">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="6">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>

        <StackPanel x:Name="PasswordPanel">
          <TextBlock Text="账号" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="UsernameBox" Style="{StaticResource InputBox}" />
          <TextBlock Text="密码" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
          <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPassword}" />
        </StackPanel>

        <StackPanel x:Name="EmailPanel" Visibility="Collapsed">
          <TextBlock Text="工作邮箱" Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}" />
          <TextBlock Text="邮箱验证码" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="EmailCodeBox" Style="{StaticResource InputBox}" />
            <Button x:Name="SendCodeBtn" Grid.Column="1" Content="发送验证码" Margin="8,0,0,0" MinWidth="96"
                    Style="{StaticResource GhostButton}" Click="SendCode_Click" />
          </Grid>
        </StackPanel>

        <StackPanel x:Name="CaptchaPanel">
          <TextBlock Text="图形验证码" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CaptchaBox" Style="{StaticResource InputBox}" KeyDown="CaptchaBox_KeyDown" />
            <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" Cursor="Hand" Background="#FAFBFC" Height="40"
                    MouseLeftButtonUp="CaptchaImage_Click" ToolTip="点击刷新验证码">
              <Grid>
                <Image x:Name="CaptchaImage" Stretch="Uniform" Margin="4" />
                <TextBlock x:Name="CaptchaPlaceholder" Text="点击加载" Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" Foreground="#D03050" TextWrapping="Wrap" FontSize="12"
                   LineHeight="18" />

        <StackPanel Margin="0,12,0,0">
          <CheckBox x:Name="RememberUsernameCheck" Content="记住账号" IsChecked="True" Margin="0,0,0,6" />
          <CheckBox x:Name="RememberEmailCheck" Content="记住邮箱" IsChecked="True" Margin="0,0,0,6" Visibility="Collapsed" />
          <CheckBox x:Name="RememberPasswordCheck" Content="记住密码" Margin="0,0,0,6" />
          <CheckBox x:Name="AutoLoginCheck" Content="自动登录（免验证码，使用本机设备令牌）" IsChecked="True" />
        </StackPanel>

        <Button x:Name="LoginButton" Content="登 录" Margin="0,16,0,0" Style="{StaticResource PrimaryButton}"
                Click="LoginButton_Click" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
