<Window x:Class="TPCWorkflow.Client.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件更新"
        Width="440"
        SizeToContent="Height"
        MinHeight="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WinContentBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI, Ubuntu, sans-serif">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Grid.Row="0" Text="发现新版本" FontSize="16" FontWeight="SemiBold"
               Foreground="{StaticResource TextPrimaryBrush}" />
    <TextBlock x:Name="VersionText" Grid.Row="1" Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
               FontSize="13" TextWrapping="Wrap" />
    <TextBlock x:Name="NotesText" Grid.Row="2" Margin="0,10,0,0" Foreground="{StaticResource TextMutedBrush}"
               FontSize="12" TextWrapping="Wrap" />

    <StackPanel Grid.Row="3" Margin="0,16,0,0">
      <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" />
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{StaticResource TextMutedBrush}"
                 FontSize="12" Visibility="Collapsed" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="LaterButton" Content="稍后提醒" Style="{StaticResource WinDialogButton}" Margin="0,0,8,0"
                Click="LaterButton_Click" />
        <Button x:Name="UpdateButton" Content="立即更新" Style="{StaticResource WinDialogPrimaryButton}"
                Click="UpdateButton_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
