<Project Sdk="Microsoft.NET.Sdk">



  <PropertyGroup>

    <OutputType>WinExe</OutputType>

    <TargetFramework>net10.0-windows</TargetFramework>

    <Nullable>enable</Nullable>

    <ImplicitUsings>enable</ImplicitUsings>

    <UseWPF>true</UseWPF>

    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>TPCWorkflow.Client</AssemblyName>

    <RootNamespace>TPCWorkflow.Client</RootNamespace>

    <ApplicationTitle>TPC 工作台</ApplicationTitle>

    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <Version>1.0.8</Version>

  </PropertyGroup>



  <ItemGroup>

    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />

  </ItemGroup>



  <!-- WPF 界面 pack:// 引用 -->

  <ItemGroup>

    <Resource Include="Assets\app.ico" />

    <Resource Include="Assets\app-icon.png" />

  </ItemGroup>



  <!-- 代码内嵌读取（单文件发布不依赖 exe 旁 Assets 目录） -->

  <ItemGroup>

    <EmbeddedResource Include="Assets\app-icon.png" LogicalName="Assets.app-icon.png" />

    <EmbeddedResource Include="Assets\app.ico" LogicalName="Assets.app.ico" />

  </ItemGroup>



  <ItemGroup>

    <None Update="appsettings.json">

      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>

    </None>

  </ItemGroup>



</Project>

